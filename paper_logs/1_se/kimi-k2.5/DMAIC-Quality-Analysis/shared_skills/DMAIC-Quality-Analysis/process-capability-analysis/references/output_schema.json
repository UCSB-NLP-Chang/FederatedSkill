{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Process Capability Analysis Output",
  "description": "Schema for process capability analysis with monitoring plan",
  "type": "object",
  "required": [
    "task_duration",
    "failure_rate",
    "system_errors",
    "variability_ranking",
    "highest_variability_process",
    "highest_risk_statement",
    "extended_analysis",
    "monitoring_plan"
  ],
  "properties": {
    "task_duration": {
      "type": "object",
      "required": ["mean", "sample_std", "cv", "trend"],
      "properties": {
        "mean": { "type": "number" },
        "sample_std": { "type": "number", "minimum": 0 },
        "cv": { "type": "number", "minimum": 0 },
        "trend": {
          "type": "object",
          "required": ["slope", "t_stat", "stability"],
          "properties": {
            "slope": { "type": "number" },
            "t_stat": { "type": "number" },
            "stability": { "type": "string", "enum": ["Stable", "Unstable"] }
          }
        }
      }
    },
    "failure_rate": {
      "type": "object",
      "required": [
        "uses_varying_denominators", "target_rate_pct", "overall_rate_pct",
        "sample_std", "cv", "wilson_95_ci_pct", "capability_vs_target", "trend"
      ],
      "properties": {
        "uses_varying_denominators": { "type": "boolean" },
        "target_rate_pct": { "type": "number" },
        "overall_rate_pct": { "type": "number", "minimum": 0 },
        "sample_std": { "type": "number", "minimum": 0 },
        "cv": { "type": "number", "minimum": 0 },
        "wilson_95_ci_pct": {
          "type": "object",
          "required": ["lower", "upper"],
          "properties": {
            "lower": { "type": "number", "minimum": 0 },
            "upper": { "type": "number", "minimum": 0 }
          }
        },
        "capability_vs_target": { "type": "string", "enum": ["Capable", "Not Capable"] },
        "trend": {
          "type": "object",
          "required": ["slope", "t_stat", "stability"],
          "properties": {
            "slope": { "type": "number" },
            "t_stat": { "type": "number" },
            "stability": { "type": "string", "enum": ["Stable", "Unstable"] }
          }
        }
      }
    },
    "system_errors": {
      "type": "object",
      "required": ["mean", "sample_std", "cv", "trend"],
      "properties": {
        "mean": { "type": "number" },
        "sample_std": { "type": "number", "minimum": 0 },
        "cv": { "type": "number", "minimum": 0 },
        "trend": {
          "type": "object",
          "required": ["slope", "t_stat", "stability"],
          "properties": {
            "slope": { "type": "number" },
            "t_stat": { "type": "number" },
            "stability": { "type": "string", "enum": ["Stable", "Unstable"] }
          }
        }
      }
    },
    "variability_ranking": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["process", "cv"],
        "properties": {
          "process": { "type": "string" },
          "cv": { "type": "number", "minimum": 0 }
        }
      }
    },
    "highest_variability_process": { "type": "string" },
    "highest_risk_statement": { "type": "string", "pattern": ".*is the highest-risk process\\.$" },
    "extended_analysis": {
      "type": "object",
      "required": ["summary", "key_findings"],
      "properties": {
        "summary": { "type": "string" },
        "key_findings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "monitoring_plan": {
      "type": "object",
      "required": [
        "process_to_be_monitored", "inputs", "outputs",
        "key_performance_indicators", "frequency_of_monitoring",
        "observation_format", "roles", "reporting_format",
        "corrective_action_process", "benchmarks",
        "prioritized_actions", "checklist",
        "momentum_plan_30_60_90", "project_codename"
      ],
      "properties": {
        "process_to_be_monitored": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "key_performance_indicators": { "type": "array", "items": { "type": "string" } },
        "frequency_of_monitoring": { "type": "string" },
        "observation_format": { "type": "string" },
        "roles": { "type": "object" },
        "reporting_format": { "type": "string" },
        "corrective_action_process": { "type": "string" },
        "benchmarks": { "type": "array", "items": { "type": "string" } },
        "prioritized_actions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 4
        },
        "checklist": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 5,
          "maxItems": 9
        },
        "momentum_plan_30_60_90": {
          "type": "object",
          "required": ["30_day", "60_day", "90_day"],
          "properties": {
            "30_day": { "type": "string" },
            "60_day": { "type": "string" },
            "90_day": { "type": "string" }
          }
        },
        "project_codename": { "type": "string" }
      }
    }
  }
}
